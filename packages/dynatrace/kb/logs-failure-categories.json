{
  "name": "dynatrace-failure-categories",
  "version": "1.0.0",
  "description": "Rule-based knowledge base for mapping Dynatrace-ingested application log errors to failure categories and suggested UAT test themes. Extended with Etihad airline domain patterns.",
  "categories": [
    {
      "id": "DOWNSTREAM_TIMEOUT",
      "title": "Downstream timeout / gateway timeout",
      "severity": "high",
      "match": {
        "anyRegex": [
          "\\b504\\b.*Gateway Timeout",
          "\\bRead timed out\\b",
          "\\btimeout\\b.*downstream",
          "\\bDownstream timeout\\b"
        ]
      }
    },
    {
      "id": "HTTP_4XX_DOWNSTREAM",
      "title": "Downstream 4xx (not found / bad request)",
      "severity": "medium",
      "match": {
        "anyRegex": [
          "\\b404\\b.*Not Found",
          "\\b400\\b.*Bad Request",
          "\\b422\\b"
        ]
      }
    },
    {
      "id": "HTTP_429_RATE_LIMIT",
      "title": "Rate limiting (HTTP 429)",
      "severity": "medium",
      "match": {
        "anyRegex": [
          "\\b429\\b.*Too Many Requests",
          "rate limit"
        ]
      }
    },
    {
      "id": "DB_SCHEMA_OR_QUERY",
      "title": "Database schema/query failure",
      "severity": "high",
      "match": {
        "anyRegex": [
          "PSQLException",
          "SQL error",
          "relation\\s+\\\".*\\\"\\s+does not exist",
          "ORA-",
          "SQLSTATE"
        ]
      }
    },
    {
      "id": "AUTHN_AUTHZ",
      "title": "Authentication/authorization failure",
      "severity": "high",
      "match": {
        "anyRegex": [
          "JWT validation failed",
          "SignatureException",
          "Unauthorized",
          "Forbidden",
          "AccessDenied",
          "invalid token"
        ]
      }
    },
    {
      "id": "INPUT_VALIDATION",
      "title": "Input validation / business rule violation",
      "severity": "low",
      "match": {
        "anyRegex": [
          "Validation error",
          "\\bpassportNumber\\b",
          "\\bPNR\\b",
          "\\bitinerary\\b",
          "must be a future date",
          "ConstraintViolation",
          "MethodArgumentNotValidException"
        ]
      }
    },
    {
      "id": "TLS_CERT",
      "title": "TLS/Certificate/Handshake failure",
      "severity": "high",
      "match": {
        "anyRegex": [
          "SSLHandshakeException",
          "PKIX path building failed",
          "certificate",
          "unable to find valid certification path"
        ]
      }
    },
    {
      "id": "NULL_POINTER_OR_BUG",
      "title": "Unhandled exception / application bug",
      "severity": "high",
      "match": {
        "anyRegex": [
          "NullPointerException",
          "Unhandled exception",
          "TypeError",
          "ReferenceError"
        ]
      }
    },
    {
      "id": "RESOURCE_EXHAUSTION",
      "title": "Resource exhaustion (OOM / thread starvation)",
      "severity": "critical",
      "match": {
        "anyRegex": [
          "OutOfMemoryError",
          "Java heap space",
          "GC overhead limit exceeded",
          "thread starvation"
        ]
      }
    },
    {
      "id": "CONFIG_SECRETS",
      "title": "Configuration / secrets / credentials issue",
      "severity": "high",
      "match": {
        "anyRegex": [
          "SMTPAuthenticationError",
          "Username and Password not accepted",
          "Invalid credentials",
          "secret",
          "configuration"
        ]
      }
    },
    {
      "id": "GENERIC_5XX",
      "title": "Generic server error (HTTP 5xx)",
      "severity": "medium",
      "match": {
        "anyRegex": [
          "\\b500\\b.*Internal Server Error",
          "\\b502\\b",
          "\\b503\\b"
        ]
      }
    }
  ]
}